# Database (Neon Postgres)
# Use the pooled URL for app traffic and direct URL for Prisma migrations.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate secret with: openssl rand -base64 32
AUTH_SECRET=""
# Only set AUTH_URL for local dev. On Vercel, leave it unset so Auth.js infers
# the origin from the request headers (otherwise OAuth redirects hit localhost).
AUTH_URL="http://localhost:3000"

# Google OAuth client (console.cloud.google.com → APIs & Services → Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Google Cloud Translation API key (console.cloud.google.com → APIs & Services → Credentials → API key)
GOOGLE_TRANSLATE_API_KEY=""

# OpenAI (platform.openai.com) — used for TTS
OPENAI_API_KEY=""

# Resend (resend.com) — used for sending transcripts
RESEND_API_KEY=""
# Free-tier caveat: without a verified domain, Resend only delivers
# to the email that owns the Resend account.
TRANSCRIPT_FROM="onboarding@resend.dev"
